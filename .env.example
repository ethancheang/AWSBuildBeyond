# Optional multiplayer. Leave these blank for single-player.
# Hostnames only: no https://, wss://, or trailing path.
VITE_APPSYNC_HTTP_HOST=
VITE_APPSYNC_REALTIME_HOST=
VITE_APPSYNC_API_KEY=

# Alternative local relay; used only when AppSync is not fully configured.
# VITE_WS_URL=ws://127.0.0.1:8080

# Optional AI order generator (POST endpoint). Blank uses authored orders only.
VITE_AI_URL=
