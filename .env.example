# Optional multiplayer. No values means single-player.
# Local relay: run npm ci --prefix server, then npm start --prefix server.
VITE_WS_URL=ws://127.0.0.1:8080

# AppSync takes precedence when all three values are supplied.
# Hosts only: omit https://, wss:// and paths.
VITE_APPSYNC_HTTP_HOST=
VITE_APPSYNC_REALTIME_HOST=
VITE_APPSYNC_API_KEY=
